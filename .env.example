# ---------------------------------------------------------------------------
# WikiMyLife - variabili d'ambiente
# Copia questo file in .env e riempi i valori. Il .env non entra mai nel repo.
#   Copy-Item .env.example .env
# ---------------------------------------------------------------------------

NODE_ENV=development
# Su Railway la porta la impone la piattaforma: non impostare PORT nel pannello.
PORT=3000
LOG_LEVEL=info

# --- CORS ------------------------------------------------------------------
# Le origini ammesse a chiamare l'API da browser, separate da virgola. Vuoto
# significa nessuna: in sviluppo va bene (si apre l'API con curl, e Vite chiama
# da localhost solo se lo elenchi qui), in produzione l'avvio fallisce.
# Un'origine e' schema + host + porta, senza barra finale e senza percorso.
CORS_ORIGINS="http://localhost:5173"

# --- Database --------------------------------------------------------------
# Deve combaciare con docker-compose.yml. Se mappi 5433:5432, cambia la porta.
DATABASE_URL="postgresql://wikimylife:wikimylife@localhost:5432/wikimylife?schema=public"
# Usato solo dai test di integrazione (npm run test:integration).
DATABASE_URL_TEST="postgresql://wikimylife:wikimylife@localhost:5432/wikimylife_test?schema=public"

# --- Autenticazione --------------------------------------------------------
# Minimo 32 caratteri: l'API rifiuta di avviarsi con un segreto piu' corto.
# Generalo con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
JWT_ACCESS_SECRET="sostituiscimi-con-almeno-32-caratteri-casuali"
ACCESS_TOKEN_TTL_MIN=15
REFRESH_TOKEN_TTL_DAYS=30
# Mettilo a false dopo aver creato il primo utente: chiude la registrazione.
SIGNUP_ENABLED=true

# --- Seed ------------------------------------------------------------------
SEED_USER_EMAIL="demo@wikimylife.local"
SEED_USER_PASSWORD="wikimylife-demo-2026"

# --- Provider --------------------------------------------------------------
# Con i default `fake` la pipeline gira per intero senza una sola chiave API:
# trascrizione, estrazione e embedding sono deterministici. E' anche cio' che
# usano i test. Passare a un provider reale senza la sua chiave fa fallire
# l'avvio, non la prima registrazione.
# fake | openai
TRANSCRIPTION_PROVIDER=fake
# fake | anthropic
EXTRACTION_PROVIDER=fake
# fake | local | s3   (local = cartella STORAGE_DIR sul disco)
# In produzione DEVE essere s3: il disco di Railway e' effimero e gli audio
# sparirebbero al primo redeploy, senza nessun errore da nessuna parte.
STORAGE_PROVIDER=fake
# fake | openai
EMBEDDING_PROVIDER=fake

OPENAI_API_KEY=
ANTHROPIC_API_KEY=

TRANSCRIPTION_MODEL=whisper-1
# Il nome del modello non e' la versione del prompt: questo cambia con il
# listino di Anthropic, `extraction.v1` cambia con le istruzioni della §4.2.
# Recording.extractionModel conserva entrambi.
EXTRACTION_MODEL=claude-sonnet-4-5-20250929

# ATTENZIONE: la migration crea una colonna vector(1536), accoppiata a
# text-embedding-3-small. Passare a text-embedding-3-large (3072 dimensioni)
# richiede una nuova migration E il re-embedding di tutte le procedure.
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536

# Cartella locale per l'audio, usata solo con STORAGE_PROVIDER=local.
STORAGE_DIR=./storage

# --- Object storage (STORAGE_PROVIDER=s3) ----------------------------------
# Serve un qualunque servizio compatibile S3: AWS S3, Cloudflare R2,
# Backblaze B2, MinIO. La firma e' scritta a mano (SigV4, ~90 righe), quindi
# cambiare fornitore e' cambiare queste variabili, non una dipendenza.
# Le quattro qui sotto sono obbligatorie se STORAGE_PROVIDER=s3; se ne manca
# anche una l'avvio fallisce elencandole tutte.
S3_BUCKET=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Vuoto = AWS. Per Cloudflare R2: https://<account-id>.r2.cloudflarestorage.com
# (e S3_REGION=auto). Per MinIO: l'URL dell'istanza.
S3_ENDPOINT=
# true solo per MinIO e simili, che non fanno l'host virtuale per bucket.
S3_FORCE_PATH_STYLE=false

# --- Frontend (apps/web, letto da Vite come import.meta.env) ---------------
# ATTENZIONE: le VITE_* finiscono nel bundle in chiaro. Qui ci va un URL, mai
# una chiave. Su Netlify si imposta nel pannello, e vale al momento della build:
# cambiarla richiede un nuovo deploy, non un riavvio.
VITE_API_URL="http://localhost:3000"
