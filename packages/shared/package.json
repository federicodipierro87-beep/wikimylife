{
  "name": "@wikimylife/shared",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Tipi, enum, schemi Zod, interfacce dei provider e client API. Isomorfo: nessuna API di browser o di Node.",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
