<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />

    <!--
      Il microfono, che e' la ragione per cui esiste questo guscio: il sistema
      lo chiede una volta e lo ricorda per l'app, invece del browser che lo
      chiede a ogni sessione.

      Tutti e due, e non solo RECORD_AUDIO. BridgeWebChromeClient di Capacitor,
      a ogni getUserMedia con l'audio, chiede insieme RECORD_AUDIO e
      MODIFY_AUDIO_SETTINGS, e concede il microfono alla pagina solo se li
      ottiene entrambi. Un permesso non dichiarato qui Android lo nega senza
      mostrare niente: il sintomo sarebbe un microfono negato per sempre, senza
      che nessun cartello sia mai comparso.
    -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />

    <!--
      La posizione di cattura. Capacitor chiede sempre le due insieme; senza la
      precisa dichiarata, ripiega sull'approssimativa solo da Android 12 in su,
      e sotto nega. La pagina chiede enableHighAccuracy: false, e da Android 12
      l'utente puo' concedere soltanto l'approssimativa: al quartiere, che e'
      cio' che la scheda usa, si arriva lo stesso.
    -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
</manifest>
